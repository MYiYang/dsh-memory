{
  "name": "dsh-memory-layered",
  "version": "0.8.0",
  "description": "Layered cross-session memory for DeepSeek Harness: L0 raw turns, L1 LLM-extracted facts with conflict resolution, L2 scenes with maxScenes eviction, L3 project + global persona, hybrid FTS + vectors (built-in 384-dim lexical hashing by default, or a configurable OpenAI-compatible embedding model with auto dimensions), plus recall injection and memory_search / memory_save / memory_extract tools",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./store": "./src/store.js",
    "./data": "./src/data.js",
    "./recall": "./src/recall.js",
    "./capture": "./src/capture.js",
    "./l0": "./src/l0.js",
    "./l1": "./src/l1.js",
    "./extract": "./src/extract.js",
    "./llm": "./src/llm.js",
    "./scheduler": "./src/scheduler.js",
    "./pipeline": "./src/pipeline.js",
    "./profile": "./src/profile.js",
    "./consolidate": "./src/consolidate.js",
    "./vector": "./src/vector.js",
    "./feature-index": "./src/feature-index.js",
    "./embedding": "./src/embedding.js",
    "./embedding-store": "./src/embedding-store.js",
    "./embed-worker": "./src/embed-worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "skills/**/SKILL.md",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "DESIGN-v2.md",
    "ANALYSIS-vector-model.md",
    "AUDIT-global-recall.md"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "sync-skills": "node ../scripts/sync-skills.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "layered-memory",
    "sqlite",
    "fts5",
    "agent-skills"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYiYang/dsh-memory.git"
  },
  "homepage": "https://github.com/MYiYang/dsh-memory#readme",
  "bugs": {
    "url": "https://github.com/MYiYang/dsh-memory/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
